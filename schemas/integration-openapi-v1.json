{
  "openapi": "3.1.0",
  "info": {
    "title": "BioWorkflowManage Integration API",
    "version": "1.5.0",
    "description": "第三方 MES、运营平台、报告系统与 AI Agent 使用的固定分析产品、Task 测试、异步结果导出及资产查询接口。所有写操作均受 Service Token scope、可移植输入引用、幂等键和审计约束。"
  },
  "servers": [{"url": "/api/v1/integration"}],
  "security": [{"serviceToken": []}],
  "paths": {
    "/openapi": {
      "get": {
        "operationId": "getIntegrationOpenAPI",
        "summary": "读取 Integration API OpenAPI 3.1 契约",
        "security": [],
        "responses": {"200": {"description": "OpenAPI 3.1 document"}}
      }
    },
    "/analysis-products": {
      "get": {
        "operationId": "listAnalysisProducts",
        "summary": "列出可供外部系统固定引用的分析产品契约",
        "x-required-scope": "workflow:read",
        "responses": {
          "200": {"description": "激活的 Analysis Product 版本列表", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AnalysisProductList"}}}},
          "401": {"$ref": "#/components/responses/Error"},
          "403": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/analysis-products/{analysis_code}/versions/{contract_version}": {
      "get": {
        "operationId": "getAnalysisProductVersion",
        "summary": "读取一个固定分析产品契约",
        "x-required-scope": "workflow:read",
        "parameters": [
          {"name": "analysis_code", "in": "path", "required": true, "schema": {"type": "string", "maxLength": 128}},
          {"name": "contract_version", "in": "path", "required": true, "schema": {"type": "string", "maxLength": 64}}
        ],
        "responses": {
          "200": {"description": "Analysis Product 固定契约", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AnalysisProductVersion"}}}},
          "404": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/workflow-versions": {
      "get": {
        "operationId": "listWorkflowVersions",
        "summary": "列出固定 WorkflowVersion",
        "x-required-scope": "workflow:read",
        "responses": {"200": {"description": "WorkflowVersion 列表"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/workflow-versions/{version_id}": {
      "get": {
        "operationId": "getWorkflowVersion",
        "summary": "读取固定 WorkflowVersion 契约",
        "x-required-scope": "workflow:read",
        "parameters": [{"name": "version_id", "in": "path", "required": true, "schema": {"type": "integer", "minimum": 1}}],
        "responses": {"200": {"description": "WorkflowVersion"}, "404": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/analysis-runs/preflight": {
      "post": {
        "operationId": "preflightAnalysisRun",
        "summary": "预检固定分析产品或 WorkflowVersion 和可移植输入，不创建运行",
        "x-required-scope": "analysis:submit",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AnalysisPreflight"}}}},
        "responses": {"200": {"description": "预检通过", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AnalysisPreflightResult"}}}}, "400": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "413": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/analysis-runs": {
      "get": {
        "operationId": "listAnalysisRuns",
        "summary": "列出当前 Service Account 的运行",
        "x-required-scope": "analysis:read",
        "parameters": [{"name": "active", "in": "query", "schema": {"type": "string", "enum": ["0", "1"]}}],
        "responses": {"200": {"description": "轻量运行摘要列表；完整字段通过详情接口读取", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AnalysisRunList"}}}}}
      },
      "post": {
        "operationId": "submitAnalysisRun",
        "summary": "幂等投递固定分析产品或 WorkflowVersion",
        "x-required-scope": "analysis:submit",
        "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}, {"$ref": "#/components/parameters/RequestId"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AnalysisSubmission"}}}},
        "responses": {"201": {"description": "创建运行", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AnalysisRun"}}}}, "200": {"description": "幂等重放", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AnalysisRun"}}}}, "400": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "413": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/analysis-runs/by-external-ref": {
      "get": {
        "operationId": "findAnalysisRunByExternalRef",
        "summary": "响应丢失后按 external_run_id 找回运行",
        "x-required-scope": "analysis:read",
        "parameters": [{"name": "external_run_id", "in": "query", "required": true, "schema": {"type": "string", "maxLength": 128}}],
        "responses": {"200": {"description": "运行", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AnalysisRun"}}}}, "404": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/analysis-runs/batch-status": {
      "post": {
        "operationId": "batchAnalysisStatus",
        "summary": "批量读取最多 200 个运行状态",
        "x-required-scope": "analysis:read",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["run_ids"], "properties": {"run_ids": {"type": "array", "maxItems": 200, "items": {"type": "string", "format": "uuid"}}}}}}},
        "responses": {"200": {"description": "批量状态"}}
      }
    },
    "/analysis-runs/{run_id}": {
      "get": {
        "operationId": "getAnalysisRun",
        "summary": "读取运行详情",
        "x-required-scope": "analysis:read",
        "parameters": [{"$ref": "#/components/parameters/RunId"}],
        "responses": {"200": {"description": "运行", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AnalysisRun"}}}}, "404": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/analysis-runs/{run_id}/events": {
      "get": {
        "operationId": "listAnalysisRunEvents",
        "summary": "按 ID 增量获取事件",
        "x-required-scope": "analysis:read",
        "parameters": [{"$ref": "#/components/parameters/RunId"}, {"name": "after_id", "in": "query", "schema": {"type": "integer", "minimum": 0, "default": 0}}],
        "responses": {"200": {"description": "事件列表"}}
      }
    },
    "/analysis-runs/{run_id}/cancel": {
      "post": {
        "operationId": "cancelAnalysisRun",
        "summary": "安全取消运行；重复调用幂等",
        "x-required-scope": "analysis:cancel",
        "parameters": [{"$ref": "#/components/parameters/RunId"}],
        "responses": {"200": {"description": "取消后的运行状态"}}
      }
    },
    "/analysis-runs/{run_id}/retry": {
      "post": {
        "operationId": "retryAnalysisRun",
        "summary": "基于原固定快照创建新的重跑记录",
        "x-required-scope": "analysis:retry",
        "parameters": [{"$ref": "#/components/parameters/RunId"}, {"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["external_ref"], "properties": {"external_ref": {"$ref": "#/components/schemas/ExternalRef"}, "metadata": {"type": "object"}}}}}},
        "responses": {"201": {"description": "新的重跑记录"}, "409": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/analysis-runs/{run_id}/outputs": {
      "get": {
        "operationId": "listAnalysisOutputs",
        "summary": "读取语义化输出清单",
        "x-required-scope": "analysis:read",
        "parameters": [{"$ref": "#/components/parameters/RunId"}],
        "responses": {"200": {"description": "按单项公开的输出清单；incomplete 清单中的已验证 File 仍可下载", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AnalysisOutputList"}}}}}
      }
    },
    "/analysis-runs/{run_id}/outputs/download": {
      "get": {
        "operationId": "downloadAnalysisOutput",
        "summary": "校验成功时输出证据后流式下载文件",
        "x-required-scope": "analysis:download",
        "parameters": [{"$ref": "#/components/parameters/RunId"}, {"name": "key", "in": "query", "required": true, "schema": {"type": "string"}}],
        "responses": {"200": {"description": "文件流"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "410": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/analysis-runs/{run_id}/artifact-exports": {
      "get": {
        "operationId": "listArtifactExports",
        "summary": "列出当前 Service Account 为该运行创建的 Artifact Export",
        "x-required-scope": "analysis:read",
        "parameters": [{"$ref": "#/components/parameters/RunId"}],
        "responses": {"200": {"description": "Artifact Export 列表", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ArtifactExportList"}}}}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}
      },
      "post": {
        "operationId": "createArtifactExport",
        "summary": "幂等创建异步 S3/MinIO 或受管目录结果导出",
        "x-required-scope": "analysis:export",
        "parameters": [{"$ref": "#/components/parameters/RunId"}, {"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ArtifactExportRequest"}}}},
        "responses": {"201": {"description": "已创建 Artifact Export", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ArtifactExport"}}}}, "200": {"description": "幂等重放", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ArtifactExport"}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "413": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/artifact-exports/{export_id}": {
      "get": {
        "operationId": "getArtifactExport",
        "summary": "读取 Artifact Export 状态、清单位置和保留门禁",
        "x-required-scope": "analysis:read",
        "parameters": [{"$ref": "#/components/parameters/ExportId"}],
        "responses": {"200": {"description": "Artifact Export", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ArtifactExport"}}}}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/artifact-exports/{export_id}/acknowledge": {
      "post": {
        "operationId": "acknowledgeArtifactExport",
        "summary": "按交付清单 SHA-256 幂等确认结果已被目标系统接收",
        "x-required-scope": "analysis:acknowledge",
        "parameters": [{"$ref": "#/components/parameters/ExportId"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ArtifactExportAcknowledgement"}}}},
        "responses": {"200": {"description": "已确认或幂等重放", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ArtifactExport"}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/tool-test-runs/preflight": {
      "post": {
        "operationId": "preflightToolTest",
        "summary": "预检不可变 ToolVersion 的独立测试",
        "x-required-scope": "task:test",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ToolTestPreflight"}}}},
        "responses": {"200": {"description": "预检通过"}, "400": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "413": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/tool-test-runs": {
      "post": {
        "operationId": "submitToolTest",
        "summary": "幂等提交不可变 ToolVersion 小数据测试",
        "x-required-scope": "task:test",
        "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ToolTestSubmission"}}}},
        "responses": {"201": {"description": "测试运行"}, "400": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "413": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/tools": {
      "get": {"operationId": "listTools", "summary": "读取已发布 ToolVersion 基本信息", "x-required-scope": "library:read", "responses": {"200": {"description": "工具版本列表"}}}
    },
    "/software": {
      "get": {"operationId": "listSoftware", "summary": "读取软件知识库基本信息", "x-required-scope": "library:read", "responses": {"200": {"description": "软件列表"}}}
    }
  },
  "webhooks": {
    "analysisRunTerminal": {
      "post": {
        "operationId": "receiveAnalysisRunTerminal",
        "summary": "接收分析运行终态事件",
        "description": "接收方必须先验证 timestamp 窗口与 HMAC-SHA256，再按 event_id 去重，并以 status_version 拒绝旧于已处理版本的乱序状态。delivery_id 在自动重试和人工重放中保持不变。",
        "parameters": [
          {"name": "X-BioWorkflow-Delivery-ID", "in": "header", "required": true, "schema": {"type": "string", "format": "uuid"}},
          {"name": "X-BioWorkflow-Event-ID", "in": "header", "required": true, "schema": {"type": "string", "format": "uuid"}},
          {"name": "X-BioWorkflow-Timestamp", "in": "header", "required": true, "schema": {"type": "string", "pattern": "^[0-9]{10,}$"}},
          {"name": "X-BioWorkflow-Secret-Version", "in": "header", "required": true, "schema": {"type": "string", "pattern": "^[1-9][0-9]*$"}},
          {"name": "X-BioWorkflow-Signature", "in": "header", "required": true, "schema": {"type": "string", "pattern": "^v1=[0-9a-f]{64}$"}}
        ],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AnalysisRunTerminalEvent"}}}},
        "responses": {
          "200": {"description": "事件已接收或已幂等处理"},
          "202": {"description": "事件已进入接收方队列"},
          "204": {"description": "事件已接收，无响应体"}
        }
      }
    },
    "artifactExportCompleted": {
      "post": {
        "operationId": "receiveArtifactExportCompleted",
        "summary": "接收 Artifact Export 完成事件",
        "description": "事件只携带交付清单摘要、目标位置和 API 链接，不内嵌分析结果文件或清单 items。接收方按 event_id 去重，并在 requires_ack=true 时使用 manifest_digest 调用确认接口。",
        "parameters": [
          {"name": "X-BioWorkflow-Delivery-ID", "in": "header", "required": true, "schema": {"type": "string", "format": "uuid"}},
          {"name": "X-BioWorkflow-Event-ID", "in": "header", "required": true, "schema": {"type": "string", "format": "uuid"}},
          {"name": "X-BioWorkflow-Timestamp", "in": "header", "required": true, "schema": {"type": "string", "pattern": "^[0-9]{10,}$"}},
          {"name": "X-BioWorkflow-Secret-Version", "in": "header", "required": true, "schema": {"type": "string", "pattern": "^[1-9][0-9]*$"}},
          {"name": "X-BioWorkflow-Signature", "in": "header", "required": true, "schema": {"type": "string", "pattern": "^v1=[0-9a-f]{64}$"}}
        ],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ArtifactExportCompletedEvent"}}}},
        "responses": {
          "200": {"description": "事件已接收或已幂等处理"},
          "202": {"description": "事件已进入接收方队列"},
          "204": {"description": "事件已接收，无响应体"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceToken": {"type": "http", "scheme": "bearer", "bearerFormat": "BioWorkflowManage Service Token"}
    },
    "parameters": {
      "RunId": {"name": "run_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "ExportId": {"name": "export_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "IdempotencyKey": {"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string", "maxLength": 128}},
      "RequestId": {"name": "X-Request-ID", "in": "header", "required": false, "schema": {"type": "string", "maxLength": 128}}
    },
    "responses": {
      "Error": {"description": "结构化错误", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}}
    },
    "schemas": {
      "ExternalRef": {
        "type": "object",
        "required": ["external_run_id"],
        "properties": {
          "client_id": {"type": "string"},
          "external_run_id": {"type": "string", "maxLength": 128},
          "external_analysis_id": {"type": "string", "maxLength": 128}
        }
      },
      "ManagedResource": {
        "type": "object",
        "required": ["root_alias", "relative_path"],
        "not": {
          "anyOf": [
            {"required": ["profile"]},
            {"required": ["bucket"]},
            {"required": ["version_id"]},
            {"required": ["etag"]},
            {"required": ["access_key_id"]},
            {"required": ["secret_access_key"]},
            {"required": ["session_token"]},
            {"required": ["endpoint_url"]},
            {"required": ["presigned_url"]}
          ]
        },
        "properties": {
          "type": {"type": "string", "description": "推荐使用 managed_path；为兼容 1.2 及更早调用方，也接受并忽略既有自定义值（包括仅出现在受管路径形态中的历史 s3_object 值）。"},
          "root_alias": {"type": "string", "enum": ["rawdata", "database"]},
          "relative_path": {"type": "string"},
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "description": "File 内容摘要。Directory 上仅作为兼容字段接受，已弃用。"
          },
          "identity_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "description": "Directory 的 sha256-tree-identity-v1 身份摘要。"
          }
        }
      },
      "S3ObjectReference": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "profile", "bucket", "key", "size", "sha256"],
        "anyOf": [
          {"required": ["version_id"]},
          {"required": ["etag"]}
        ],
        "properties": {
          "type": {"type": "string", "const": "s3_object"},
          "profile": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$", "description": "部署侧对象存储 profile；不是凭据。"},
          "bucket": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{0,62}$"},
          "key": {"type": "string", "minLength": 1, "maxLength": 1024},
          "version_id": {"type": "string", "minLength": 1, "maxLength": 1024},
          "etag": {"type": "string", "minLength": 1, "maxLength": 1024},
          "size": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"}
        }
      },
      "InputReference": {
        "description": "File 输入支持 legacy managed path 或固定的 S3-compatible object reference。Directory 仅支持 managed path。",
        "oneOf": [
          {"$ref": "#/components/schemas/ManagedResource"},
          {"$ref": "#/components/schemas/S3ObjectReference"}
        ]
      },
      "InputValue": {
        "description": "由固定契约解释的标量、File/Directory 引用或递归数组/Pair（Pair 使用两个元素的数组）。",
        "anyOf": [
          {"$ref": "#/components/schemas/InputReference"},
          {"type": "array", "items": {"$ref": "#/components/schemas/InputValue"}},
          {"type": ["string", "number", "boolean", "null"]}
        ]
      },
      "DatabaseSelection": {
        "type": "object",
        "properties": {
          "reference_id": {"type": "string", "maxLength": 128},
          "panel_id": {"type": "string", "maxLength": 128}
        },
        "additionalProperties": false
      },
      "WorkflowVersionRef": {
        "type": "object",
        "required": ["source_type", "version_id", "expected_source_digest"],
        "properties": {
          "source_type": {"const": "workflow_version"},
          "version_id": {"type": "integer", "minimum": 1},
          "expected_source_digest": {"type": "string"}
        }
      },
      "AnalysisProductRef": {
        "type": "object",
        "required": ["analysis_code", "contract_version"],
        "properties": {
          "analysis_code": {"type": "string", "maxLength": 128},
          "contract_version": {"type": "string", "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"}
        },
        "additionalProperties": false
      },
      "AnalysisProductVersion": {
        "type": "object",
        "required": ["analysis_code", "contract_version", "contract_digest", "workflow", "interface", "ready"],
        "properties": {
          "analysis_code": {"type": "string"},
          "contract_version": {"type": "string"},
          "contract_digest": {"type": "string"},
          "name": {"type": "string"},
          "description": {"type": "string"},
          "active": {"type": "boolean"},
          "workflow": {"type": "object"},
          "interface": {"type": "object"},
          "input_contract": {"type": "array", "items": {"type": "object"}},
          "output_contract": {"type": "array", "items": {"type": "object"}},
          "ready": {"type": "boolean"},
          "blockers": {"type": "array", "items": {"type": "string"}}
        }
      },
      "AnalysisProductList": {
        "type": "object",
        "required": ["results"],
        "properties": {
          "results": {"type": "array", "maxItems": 200, "items": {"$ref": "#/components/schemas/AnalysisProductVersion"}}
        }
      },
      "AnalysisProductRunRef": {
        "type": "object",
        "required": ["analysis_code", "contract_version", "contract_digest"],
        "properties": {
          "analysis_code": {"type": "string", "maxLength": 128},
          "contract_version": {"type": "string", "maxLength": 64},
          "contract_digest": {"type": "string"}
        },
        "additionalProperties": false
      },
      "AnalysisSubmission": {
        "type": "object",
        "required": ["external_ref", "subject", "inputs"],
        "oneOf": [
          {"required": ["analysis_product"], "not": {"required": ["workflow"]}},
          {"required": ["workflow"], "not": {"required": ["analysis_product"]}}
        ],
        "properties": {
          "external_ref": {"$ref": "#/components/schemas/ExternalRef"},
          "workflow": {"$ref": "#/components/schemas/WorkflowVersionRef"},
          "analysis_product": {"$ref": "#/components/schemas/AnalysisProductRef"},
          "subject": {"type": "object", "required": ["sample_id"], "properties": {"sample_id": {"type": "string", "maxLength": 128}}},
          "inputs": {"type": "object", "additionalProperties": {"$ref": "#/components/schemas/InputValue"}, "description": "按分析契约提供输入；File 值使用 InputReference，数组与 Pair 可递归包含 InputReference。"},
          "database": {"$ref": "#/components/schemas/DatabaseSelection"},
          "metadata": {"type": "object", "additionalProperties": true}
        }
      },
      "AnalysisPreflight": {
        "type": "object",
        "required": ["inputs"],
        "oneOf": [
          {"required": ["analysis_product"], "not": {"required": ["workflow"]}},
          {"required": ["workflow"], "not": {"required": ["analysis_product"]}}
        ],
        "properties": {
          "workflow": {"$ref": "#/components/schemas/WorkflowVersionRef"},
          "analysis_product": {"$ref": "#/components/schemas/AnalysisProductRef"},
          "inputs": {"type": "object", "additionalProperties": {"$ref": "#/components/schemas/InputValue"}, "description": "按分析契约提供输入；File 值使用 InputReference，数组与 Pair 可递归包含 InputReference。"},
          "database": {"$ref": "#/components/schemas/DatabaseSelection"},
          "metadata": {"type": "object", "additionalProperties": true}
        }
      },
      "AnalysisPreflightResult": {
        "type": "object",
        "required": ["ready", "submission_allowed", "waiting_for", "workflow", "analysis_product", "checks", "resource_manifest", "output_contract", "metadata"],
        "properties": {
          "ready": {"type": "boolean"},
          "submission_allowed": {"type": "boolean"},
          "waiting_for": {"type": "array", "items": {"type": "string"}},
          "workflow": {"type": "object"},
          "analysis_product": {"oneOf": [{"type": "object"}, {"type": "null"}]},
          "checks": {"type": "array", "items": {"type": "object"}},
          "resource_manifest": {"type": "object"},
          "output_contract": {"type": "array", "items": {"type": "object"}},
          "metadata": {"type": "object"}
        }
      },
      "ToolTestPreflight": {
        "type": "object",
        "required": ["tool", "inputs"],
        "properties": {
          "tool": {"type": "object", "required": ["tool_id", "version", "expected_digest"], "properties": {"tool_id": {"type": "string"}, "version": {"type": "string"}, "expected_digest": {"type": "string"}}},
          "inputs": {"type": "object", "additionalProperties": {"$ref": "#/components/schemas/InputValue"}, "description": "File 值使用 InputReference；凭据仅来自部署侧 profile。"}
        }
      },
      "ToolTestSubmission": {
        "type": "object",
        "required": ["external_ref", "tool", "inputs"],
        "properties": {
          "external_ref": {"$ref": "#/components/schemas/ExternalRef"},
          "tool": {"type": "object", "required": ["tool_id", "version", "expected_digest"], "properties": {"tool_id": {"type": "string"}, "version": {"type": "string"}, "expected_digest": {"type": "string"}}},
          "inputs": {"type": "object", "additionalProperties": {"$ref": "#/components/schemas/InputValue"}, "description": "File 值使用 InputReference；凭据仅来自部署侧 profile。"},
          "label": {"type": "string", "maxLength": 256}
        }
      },
      "AnalysisRun": {
        "type": "object",
        "required": ["id", "request_digest", "external_ref", "status", "status_version", "execution_status", "output_status"],
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "request_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "external_ref": {"$ref": "#/components/schemas/ExternalRef"},
          "analysis_product": {"oneOf": [{"$ref": "#/components/schemas/AnalysisProductRunRef"}, {"type": "null"}]},
          "status": {"type": "string", "enum": ["queued", "preparing", "running", "cancel_requested", "succeeded", "failed", "canceled"]},
          "status_version": {"type": "integer", "minimum": 1},
          "execution_status": {"type": "string"},
          "output_status": {"type": "string", "enum": ["pending", "complete", "incomplete", "unavailable"]},
          "progress": {"type": "integer", "minimum": 0, "maximum": 100},
          "error": {"oneOf": [{"$ref": "#/components/schemas/Error"}, {"type": "null"}]},
          "outputs": {"type": "array", "items": {"type": "object"}}
        }
      },
      "AnalysisRunList": {
        "type": "object",
        "description": "列表项为轻量摘要：outputs 固定为空，错误详情与 task timing 不展开。",
        "required": ["view", "results"],
        "properties": {
          "view": {"type": "string", "const": "summary"},
          "results": {"type": "array", "maxItems": 200, "items": {"$ref": "#/components/schemas/AnalysisRun"}}
        }
      },
      "AnalysisOutputItem": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "name", "semantic_type", "wdl_type", "required", "kind"],
        "properties": {
          "key": {"type": "string"},
          "name": {"type": "string"},
          "label": {"type": "string"},
          "semantic_type": {"type": "string"},
          "wdl_type": {"type": "string"},
          "required": {"type": "boolean"},
          "kind": {"type": "string", "enum": ["file", "directory", "value", "unverifiable"]},
          "reason": {"type": "string"},
          "filename": {"type": "string"},
          "size": {"type": "integer", "minimum": 0},
          "content_type": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "entry_count": {"type": "integer", "minimum": 0},
          "digest": {"type": "string"},
          "value": {},
          "download_url": {"type": "string"}
        }
      },
      "AnalysisOutputList": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_id", "execution_status", "output_status", "error", "results"],
        "properties": {
          "run_id": {"type": "string", "format": "uuid"},
          "execution_status": {"type": "string", "enum": ["queued", "preparing", "running", "cancel_requested", "succeeded", "failed", "canceled"]},
          "output_status": {"type": "string", "enum": ["pending", "complete", "incomplete", "unavailable"]},
          "error": {"oneOf": [{"$ref": "#/components/schemas/Error"}, {"type": "null"}]},
          "results": {"type": "array", "items": {"$ref": "#/components/schemas/AnalysisOutputItem"}}
        }
      },
      "ArtifactExportRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target"],
        "properties": {
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": ["profile"],
            "properties": {
              "profile": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$", "description": "部署侧 Artifact Export profile；请求体不接受目录、endpoint 或任何凭据。"}
            }
          },
          "requires_ack": {"type": "boolean", "default": true},
          "retain_until": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]}
        }
      },
      "ArtifactExportAcknowledgement": {
        "type": "object",
        "additionalProperties": false,
        "required": ["manifest_digest"],
        "properties": {
          "manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "external_receipt": {"type": "string", "maxLength": 128}
        }
      },
      "ArtifactExportTarget": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "profile", "root_alias"],
            "properties": {
              "type": {"const": "managed_directory"},
              "profile": {"type": "string"},
              "root_alias": {"type": "string"},
              "public_uri_prefix": {"type": "string"}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "profile", "endpoint_origin", "bucket", "prefix"],
            "properties": {
              "type": {"const": "s3"},
              "profile": {"type": "string"},
              "endpoint_origin": {"type": "string", "format": "uri"},
              "bucket": {"type": "string"},
              "prefix": {"type": "string"}
            }
          }
        ]
      },
      "ArtifactLocation": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "profile", "root_alias", "relative_path", "uri", "size", "sha256"],
            "properties": {
              "type": {"const": "managed_directory"},
              "profile": {"type": "string"},
              "root_alias": {"type": "string"},
              "relative_path": {"type": "string"},
              "uri": {"type": "string"},
              "size": {"type": "integer", "minimum": 0},
              "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "profile", "bucket", "key", "uri", "size", "sha256"],
            "properties": {
              "type": {"const": "s3_object"},
              "profile": {"type": "string"},
              "bucket": {"type": "string"},
              "key": {"type": "string"},
              "uri": {"type": "string"},
              "size": {"type": "integer", "minimum": 0},
              "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "etag": {"type": "string"},
              "version_id": {"type": "string"}
            }
          }
        ]
      },
      "ArtifactDeliveryItem": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "name", "semantic_type", "wdl_type", "required", "kind"],
        "properties": {
          "key": {"type": "string"},
          "name": {"type": "string"},
          "label": {"type": "string"},
          "semantic_type": {"type": "string"},
          "wdl_type": {"type": "string"},
          "required": {"type": "boolean"},
          "kind": {"type": "string", "enum": ["file", "value"]},
          "filename": {"type": "string"},
          "size": {"type": "integer", "minimum": 0},
          "content_type": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "value": {},
          "destination": {"$ref": "#/components/schemas/ArtifactLocation"}
        }
      },
      "ArtifactDeliveryManifest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_version", "export_id", "run_id", "source_manifest_digest", "target", "completed_at", "items", "summary"],
        "properties": {
          "schema_version": {"type": "integer", "const": 1},
          "export_id": {"type": "string", "format": "uuid"},
          "run_id": {"type": "string", "format": "uuid"},
          "source_manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "target": {"$ref": "#/components/schemas/ArtifactExportTarget"},
          "completed_at": {"type": "string", "format": "date-time"},
          "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/components/schemas/ArtifactDeliveryItem"}},
          "summary": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file_count", "item_count", "total_bytes"],
            "properties": {
              "file_count": {"type": "integer", "minimum": 0},
              "item_count": {"type": "integer", "minimum": 1},
              "total_bytes": {"type": "integer", "minimum": 0}
            }
          }
        }
      },
      "ArtifactExport": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "run_id", "state", "target", "source_manifest_digest", "manifest_digest", "manifest_location", "manifest", "requires_ack", "acknowledged_at", "attempt_count", "replay_count", "next_attempt_at", "completed_at", "error", "retention", "created_at", "updated_at", "links"],
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "run_id": {"type": "string", "format": "uuid"},
          "state": {"type": "string", "enum": ["pending", "exporting", "succeeded", "dead_letter"]},
          "target": {"$ref": "#/components/schemas/ArtifactExportTarget"},
          "source_manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "manifest_digest": {"oneOf": [{"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, {"type": "null"}]},
          "manifest_location": {"oneOf": [{"$ref": "#/components/schemas/ArtifactLocation"}, {"type": "null"}]},
          "manifest": {"oneOf": [{"$ref": "#/components/schemas/ArtifactDeliveryManifest"}, {"type": "null"}]},
          "requires_ack": {"type": "boolean"},
          "acknowledged_at": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
          "attempt_count": {"type": "integer", "minimum": 0},
          "replay_count": {"type": "integer", "minimum": 0},
          "next_attempt_at": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
          "completed_at": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
          "error": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["code", "message", "retryable"],
                "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "retryable": {"type": "boolean"}}
              },
              {"type": "null"}
            ]
          },
          "retention": {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "retain_until", "cleanup_eligible", "cleanup_blockers", "quarantined_at", "cleaned_at"],
            "properties": {
              "state": {"type": "string", "enum": ["protected", "cleaning", "cleaned", "failed"]},
              "retain_until": {"type": "string", "format": "date-time"},
              "cleanup_eligible": {"type": "boolean"},
              "cleanup_blockers": {"type": "array", "items": {"type": "string"}},
              "quarantined_at": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
              "cleaned_at": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]}
            }
          },
          "created_at": {"type": "string", "format": "date-time"},
          "updated_at": {"type": "string", "format": "date-time"},
          "links": {
            "type": "object",
            "additionalProperties": false,
            "required": ["self", "acknowledge", "run"],
            "properties": {"self": {"type": "string"}, "acknowledge": {"type": "string"}, "run": {"type": "string"}}
          }
        }
      },
      "ArtifactExportList": {
        "type": "object",
        "additionalProperties": false,
        "description": "轻量列表；每项 manifest 固定为 null，完整交付清单通过 Artifact Export 详情读取。",
        "required": ["view", "run_id", "results"],
        "properties": {
          "view": {"type": "string", "const": "summary"},
          "run_id": {"type": "string", "format": "uuid"},
          "results": {"type": "array", "maxItems": 200, "items": {"$ref": "#/components/schemas/ArtifactExport"}}
        }
      },
      "ArtifactExportCompletedEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_version", "event_id", "event_type", "occurred_at", "data"],
        "properties": {
          "schema_version": {"type": "string", "const": "1.0.0"},
          "event_id": {"type": "string", "format": "uuid"},
          "event_type": {"type": "string", "const": "analysis.artifact_export.completed"},
          "occurred_at": {"type": "string", "format": "date-time"},
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["artifact_export_id", "run_id", "external_ref", "status_version", "state", "manifest_digest", "manifest_location", "requires_ack", "links"],
            "properties": {
              "artifact_export_id": {"type": "string", "format": "uuid"},
              "run_id": {"type": "string", "format": "uuid"},
              "external_ref": {"$ref": "#/components/schemas/ExternalRef"},
              "status_version": {"type": "integer", "minimum": 1},
              "state": {"type": "string", "const": "succeeded"},
              "manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "manifest_location": {"$ref": "#/components/schemas/ArtifactLocation"},
              "requires_ack": {"type": "boolean"},
              "links": {
                "type": "object",
                "additionalProperties": false,
                "required": ["artifact_export", "manifest", "acknowledge", "run"],
                "properties": {"artifact_export": {"type": "string"}, "manifest": {"type": "string"}, "acknowledge": {"type": "string"}, "run": {"type": "string"}}
              }
            }
          }
        }
      },
      "AnalysisRunTerminalEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_version", "event_id", "event_type", "occurred_at", "data"],
        "properties": {
          "schema_version": {"type": "string", "const": "1.0.0"},
          "event_id": {"type": "string", "format": "uuid"},
          "event_type": {"type": "string", "const": "analysis.run.terminal"},
          "occurred_at": {"type": "string", "format": "date-time"},
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["run_id", "run_kind", "external_ref", "analysis_product", "status", "status_version", "output_status", "finished_at", "error", "links"],
            "properties": {
              "run_id": {"type": "string", "format": "uuid"},
              "run_kind": {"type": "string", "enum": ["workflow", "tool_test"]},
              "external_ref": {"$ref": "#/components/schemas/ExternalRef"},
              "analysis_product": {"oneOf": [{"$ref": "#/components/schemas/AnalysisProductRunRef"}, {"type": "null"}]},
              "status": {"type": "string", "enum": ["succeeded", "failed", "canceled"]},
              "status_version": {"type": "integer", "minimum": 1},
              "output_status": {"type": "string", "enum": ["complete", "incomplete", "unavailable"]},
              "finished_at": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
              "error": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["code", "category", "retryable"],
                    "properties": {
                      "code": {"type": "string"},
                      "category": {"type": "string"},
                      "retryable": {"type": "boolean"}
                    }
                  },
                  {"type": "null"}
                ]
              },
              "links": {
                "type": "object",
                "additionalProperties": false,
                "required": ["run", "outputs"],
                "properties": {
                  "run": {"type": "string"},
                  "outputs": {"type": "string"}
                }
              }
            }
          }
        }
      },
      "ErrorEnvelope": {"type": "object", "required": ["error"], "properties": {"error": {"$ref": "#/components/schemas/Error"}}},
      "Error": {
        "type": "object",
        "required": ["code", "category", "message", "retryable", "details"],
        "properties": {
          "code": {"type": "string"},
          "category": {"type": "string", "enum": ["validation", "authentication", "authorization", "input", "workflow", "resource", "infrastructure", "application", "cancellation"]},
          "message": {"type": "string"},
          "retryable": {"type": "boolean"},
          "details": {"type": "object"},
          "request_id": {"type": "string"}
        }
      }
    }
  }
}
