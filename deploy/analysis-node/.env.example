ANALYSIS_NODE_VERSION=1.0.0
ANALYSIS_NODE_PROJECT_NAME=analysis-node
ANALYSIS_NODE_MODE=headless
ANALYSIS_NODE_RUNTIME=isolated
ANALYSIS_NODE_BIND_ADDRESS=127.0.0.1
ANALYSIS_NODE_API_PORT=8082
ANALYSIS_NODE_CONSOLE_PORT=8082
ANALYSIS_NODE_PUBLIC_BASE_URL=https://analysis.example.com
ANALYSIS_NODE_MIN_FREE_GB=50

POSTGRES_DB=bioworkflow
POSTGRES_USER=bioworkflow
POSTGRES_PASSWORD=
DJANGO_SECRET_KEY=
WEBHOOK_SIGNING_KEY=
DJANGO_ALLOWED_HOSTS=analysis.example.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://analysis.example.com
CORS_ALLOWED_ORIGINS=https://analysis.example.com
DJANGO_AUTH_REQUIRED=1
DJANGO_SESSION_COOKIE_SECURE=1
DJANGO_CSRF_COOKIE_SECURE=1
DJANGO_TRUSTED_PROXY_COUNT=1
DJANGO_SEED_USERS=0
DJANGO_SEED_DEMO=0
DJANGO_SEED_ALLOW_DEFAULT_PASSWORDS=0
INTEGRATION_REQUIRE_ANALYSIS_PRODUCT=1

ANALYSIS_NODE_DATA_ROOT=/opt/analysis-node/data
ANALYSIS_NODE_BACKUP_ROOT=/opt/analysis-node-backups
ANALYSIS_NODE_POSTGRES_PATH=/opt/analysis-node/data/postgres
ANALYSIS_NODE_DIND_PATH=/opt/analysis-node/data/dind
ANALYSIS_NODE_DIND_CERT_PATH=/opt/analysis-node/data/dind-certs
ANALYSIS_WORKSPACE_HOST_PATH=/opt/analysis-node/data/workspace
ANALYSIS_RAWDATA_HOST_PATH=/opt/analysis-node/data/workspace/rawdata
ANALYSIS_DATABASE_HOST_PATH=/opt/analysis-node/data/workspace/databases
ANALYSIS_RUN_HOST_PATH=/opt/analysis-node/data/workspace/analysis-runs
ANALYSIS_INPUT_STAGING_HOST_PATH=/opt/analysis-node/data/workspace/input-staging
ANALYSIS_CACHE_HOST_PATH=/opt/analysis-node/data/workspace/analysis-cache
ANALYSIS_ARTIFACT_EXPORT_HOST_PATH=/opt/analysis-node/data/workspace/artifact-exports
ANALYSIS_OBJECT_STORAGE_SECRETS_HOST_PATH=/opt/analysis-node/secrets/object-storage
ANALYSIS_ARTIFACT_EXPORT_SECRETS_HOST_PATH=/opt/analysis-node/secrets/artifact-export

# Isolated runtime uses the container paths below. Host runtime must replace each
# value with the identical absolute *_HOST_PATH value.
ANALYSIS_RAWDATA_EXECUTION_ROOT=/analysis/rawdata
ANALYSIS_DATABASE_EXECUTION_ROOT=/analysis/databases
ANALYSIS_RUN_EXECUTION_ROOT=/analysis/runs
ANALYSIS_INPUT_STAGING_EXECUTION_ROOT=/analysis/input-staging

MINIWDL_UID=1000
MINIWDL_GID=1000
MINIWDL_DOCKER_GID=998
MINIWDL_CONTROL_SUBNET=10.253.0.0/24
MINIWDL_EGRESS_SUBNET=10.253.1.0/24
ANALYSIS_MIN_AVAILABLE_MEMORY_GB=8
ANALYSIS_INFRASTRUCTURE_RETRIES=0
ANALYSIS_INFRASTRUCTURE_RETRY_DELAY_SECONDS=15

ANALYSIS_OBJECT_STAGE_RETENTION_DAYS=30
ANALYSIS_OBJECT_STAGE_GC_HIGH_WATER_PERCENT=85
ANALYSIS_OBJECT_STAGE_GC_LOW_WATER_PERCENT=75
ANALYSIS_OBJECT_STAGE_GC_MAX_FILES=1000
ANALYSIS_OBJECT_STAGE_GC_SCAN_MAX_FILES=1000000
ANALYSIS_ARTIFACT_RETENTION_MIN_DAYS=30
ANALYSIS_ARTIFACT_RETENTION_MAX_DAYS=3650
