{
  "schema_version": "1.0.0",
  "id": "fastp_bwa_demo",
  "name": "fastp → BWA-MEM demo",
  "description": "Paired-end quality control followed by reference alignment.",
  "target": {
    "language": "wdl",
    "version": "1.0",
    "profile": "miniwdl-compatible"
  },
  "nodes": [
    {
      "id": "input_reads_1",
      "type": "workflow_input",
      "label": "Read 1 FASTQ",
      "port": {
        "name": "value",
        "wdl_type": "File",
        "semantic_type": "bio.fastq.gz.r1",
        "required": true
      }
    },
    {
      "id": "input_reads_2",
      "type": "workflow_input",
      "label": "Read 2 FASTQ",
      "port": {
        "name": "value",
        "wdl_type": "File",
        "semantic_type": "bio.fastq.gz.r2",
        "required": true
      }
    },
    {
      "id": "input_reference",
      "type": "workflow_input",
      "label": "Reference FASTA",
      "port": {
        "name": "value",
        "wdl_type": "File",
        "semantic_type": "bio.reference.fasta",
        "required": true
      }
    },
    {
      "id": "fastp_1",
      "type": "tool",
      "label": "fastp",
      "tool_ref": {
        "id": "fastp",
        "tool_version": "0.23.4",
        "spec_version": "1.0.0",
        "digest": "sha256:f65755c1e908864e19c2eefd7781a7dc035de02a90538b2ec527823bdab41bcc"
      },
      "parameter_values": {
        "threads": 4
      }
    },
    {
      "id": "bwa_mem_1",
      "type": "tool",
      "label": "BWA-MEM",
      "tool_ref": {
        "id": "bwa_mem",
        "tool_version": "0.7.17",
        "spec_version": "1.0.0",
        "digest": "sha256:55e326f6622aa2fbf9c5fa209e77f2ad08514dbfe8ff169b863941f2b1379bd2"
      },
      "parameter_values": {
        "threads": 8
      }
    },
    {
      "id": "output_aligned_bam",
      "type": "workflow_output",
      "label": "Aligned BAM",
      "port": {
        "name": "value",
        "wdl_type": "File",
        "semantic_type": "bio.alignment.bam"
      }
    }
