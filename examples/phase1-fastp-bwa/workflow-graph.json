  "edges": [
    {
      "id": "edge_reads_1_fastp",
      "source": {
        "node_id": "input_reads_1",
        "port": "value"
      },
      "target": {
        "node_id": "fastp_1",
        "port": "reads_1"
      }
    },
    {
      "id": "edge_reads_2_fastp",
      "source": {
        "node_id": "input_reads_2",
        "port": "value"
      },
      "target": {
        "node_id": "fastp_1",
        "port": "reads_2"
      }
    },
    {
      "id": "edge_reference_bwa",
      "source": {
        "node_id": "input_reference",
        "port": "value"
      },
      "target": {
        "node_id": "bwa_mem_1",
        "port": "reference"
      }
    },
    {
      "id": "edge_fastp_clean_1_bwa",
      "source": {
        "node_id": "fastp_1",
        "port": "clean_reads_1"
      },
      "target": {
        "node_id": "bwa_mem_1",
        "port": "reads_1"
      }
    },
    {
      "id": "edge_fastp_clean_2_bwa",
      "source": {
        "node_id": "fastp_1",
        "port": "clean_reads_2"
      },
      "target": {
        "node_id": "bwa_mem_1",
        "port": "reads_2"
