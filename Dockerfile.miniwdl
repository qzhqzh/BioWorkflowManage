ARG UV_BASE_IMAGE=m.daocloud.io/ghcr.io/astral-sh/uv:0.11.6@sha256:b1e699368d24c57cda93c338a57a8c5a119009ba809305cc8e86986d4a006754
ARG PYTHON_BASE_IMAGE=m.daocloud.io/docker.io/library/python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de
FROM ${UV_BASE_IMAGE} AS uv
FROM ${PYTHON_BASE_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MINIWDL_CFG=/etc/miniwdl/miniwdl.cfg

COPY --from=uv /uv /usr/local/bin/uv
COPY docker/miniwdl-requirements.txt /tmp/miniwdl-requirements.txt
RUN uv pip install --system --no-cache --require-hashes \
        --index-url https://pypi.tuna.tsinghua.edu.cn/simple \
        -r /tmp/miniwdl-requirements.txt

COPY docker/miniwdl.cfg /etc/miniwdl/miniwdl.cfg
COPY docker/miniwdl-entrypoint.sh /usr/local/bin/miniwdl-entrypoint
RUN chmod 0755 /usr/local/bin/miniwdl-entrypoint

WORKDIR /workspace
ENTRYPOINT ["miniwdl-entrypoint"]
CMD ["miniwdl", "--version"]
