FROM python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MINIWDL_CFG=/etc/miniwdl/miniwdl.cfg

COPY docker/miniwdl-requirements.txt /tmp/miniwdl-requirements.txt
RUN pip install --no-cache-dir -r /tmp/miniwdl-requirements.txt

COPY docker/miniwdl.cfg /etc/miniwdl/miniwdl.cfg
COPY docker/miniwdl-entrypoint.sh /usr/local/bin/miniwdl-entrypoint
RUN chmod 0755 /usr/local/bin/miniwdl-entrypoint

WORKDIR /workspace
ENTRYPOINT ["miniwdl-entrypoint"]
CMD ["miniwdl", "--version"]
