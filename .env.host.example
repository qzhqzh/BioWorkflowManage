POSTGRES_DB=bioworkflow
POSTGRES_USER=bioworkflow
POSTGRES_PASSWORD=
DJANGO_SECRET_KEY=
DJANGO_SEED_USERS=0
DJANGO_SEED_DEMO=0
DJANGO_SEED_ALLOW_DEFAULT_PASSWORDS=0
APP_PORT=8082

# The host worker and Docker Swarm tasks must use these same absolute paths.
ANALYSIS_WORKSPACE_HOST_PATH=/mnt/nas/workspace
ANALYSIS_DATABASE_HOST_PATH=/mnt/nas/workspace/databases
ANALYSIS_RAWDATA_HOST_PATH=/mnt/nas/workspace/rawdata
ANALYSIS_RUN_HOST_PATH=/mnt/nas/workspace/analysis-runs
ANALYSIS_RUN_EXECUTION_ROOT=/mnt/nas/workspace/analysis-runs
ANALYSIS_INPUT_STAGING_HOST_PATH=/mnt/nas/workspace/input-staging
ANALYSIS_INPUT_STAGING_EXECUTION_ROOT=/mnt/nas/workspace/input-staging
ANALYSIS_CACHE_HOST_PATH=/mnt/nas/workspace/analysis-cache
ANALYSIS_DATABASE_EXECUTION_ROOT=/mnt/nas/workspace/databases
ANALYSIS_RAWDATA_EXECUTION_ROOT=/mnt/nas/workspace/rawdata
ANALYSIS_OBJECT_STORAGE_SECRETS_HOST_PATH=./secrets/object-storage
ANALYSIS_ARTIFACT_EXPORT_HOST_PATH=/mnt/nas/workspace/artifact-exports
ANALYSIS_ARTIFACT_EXPORT_SECRETS_HOST_PATH=./secrets/artifact-export

# 32 GB is the largest current task request; keep at least 8 GB for the host.
ANALYSIS_MIN_AVAILABLE_MEMORY_GB=40
# Leave disabled in production: retry only after Docker/Swarm health is verified.
ANALYSIS_INFRASTRUCTURE_RETRIES=0
ANALYSIS_INFRASTRUCTURE_RETRY_DELAY_SECONDS=15

# Replace with: stat -c '%g' /var/run/docker.sock
MINIWDL_DOCKER_GID=
# These IDs must be able to write analysis-runs and analysis-cache on the NAS.
MINIWDL_UID=1000
MINIWDL_GID=1000
