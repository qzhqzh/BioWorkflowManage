ARG PYTHON_BASE_IMAGE=m.daocloud.io/docker.io/library/python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de
ARG UV_BASE_IMAGE=m.daocloud.io/ghcr.io/astral-sh/uv:0.11.6@sha256:b1e699368d24c57cda93c338a57a8c5a119009ba809305cc8e86986d4a006754
FROM ${UV_BASE_IMAGE} AS uv
FROM ${PYTHON_BASE_IMAGE} AS runtime
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PATH=/app/.venv/bin:$PATH PYTHONPATH=/app/backend DJANGO_SETTINGS_MODULE=config.settings MINIWDL_CFG=/app/docker/miniwdl.cfg
COPY --from=uv /uv /usr/local/bin/uv
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --only-group runtime-execution --no-install-project --no-cache
COPY backend ./backend
COPY schemas ./schemas
COPY docker/miniwdl.cfg docker/worker_process.py ./docker/
RUN chmod -R a+rX /app/backend /app/schemas /app/docker
ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64 NXF_OFFLINE=true
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl docker-cli git openjdk-21-jre-headless \
    && curl -fsSL https://github.com/nextflow-io/nextflow/releases/download/v25.04.8/nextflow-25.04.8-dist -o /usr/local/bin/nextflow \
    && echo "df18b2c5d89b47f471c71379a8f830a79973c1ba6ff56a55289483764d5e02ac  /usr/local/bin/nextflow" | sha256sum -c - \
    && chmod 0755 /usr/local/bin/nextflow && rm -rf /var/lib/apt/lists/*
LABEL org.opencontainers.image.title="BWM worker-nextflow"
CMD ["python", "/app/docker/worker_process.py", "run", "python", "backend/manage.py", "run_analysis_worker", "--engine", "nextflow"]
