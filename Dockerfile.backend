ARG UV_BASE_IMAGE=m.daocloud.io/ghcr.io/astral-sh/uv:0.11.6@sha256:b1e699368d24c57cda93c338a57a8c5a119009ba809305cc8e86986d4a006754
ARG SPROCKET_BASE_IMAGE=ghcr.io/stjude-rust-labs/sprocket:v0.28.0@sha256:6054fcaab0d512d11737717a2bab7e76f36c1225cf15fc2479f5bfa650b95f0b
ARG PYTHON_BASE_IMAGE=m.daocloud.io/docker.io/library/python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de
ARG ANALYSIS_NODE_VERSION=dev
ARG GIT_REVISION=unknown

FROM ${UV_BASE_IMAGE} AS uv
FROM ${SPROCKET_BASE_IMAGE} AS sprocket

FROM ${PYTHON_BASE_IMAGE} AS app

ARG ANALYSIS_NODE_VERSION
ARG GIT_REVISION
LABEL org.opencontainers.image.title="BioWorkflowManage Analysis Node backend" \
    org.opencontainers.image.version="${ANALYSIS_NODE_VERSION}" \
    org.opencontainers.image.revision="${GIT_REVISION}" \
    org.opencontainers.image.source="https://github.com/qzhqzh/BioWorkflowManage"

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH=/app/.venv/bin:$PATH \
    PYTHONPATH=/app/backend \
    SPROCKET_BINARY=/usr/local/bin/sprocket \
    SPROCKET_FORMAT_CONFIG=/app/docker/sprocket-format.toml \
    MINIWDL_CFG=/etc/miniwdl/miniwdl.cfg

COPY --from=sprocket /opt/sprocket/bin/sprocket /usr/local/bin/sprocket
COPY --from=uv /uv /usr/local/bin/uv

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project --no-cache

COPY backend ./backend
COPY schemas ./schemas
COPY examples ./examples
COPY docker/sprocket-format.toml ./docker/sprocket-format.toml
COPY docker/miniwdl.cfg /etc/miniwdl/miniwdl.cfg
COPY docker/backend-entrypoint.sh /usr/local/bin/backend-entrypoint
RUN chmod -R a+rX /app/backend /app/schemas /app/examples /app/docker \
    && chmod 0755 /usr/local/bin/backend-entrypoint \
    && sprocket --version

EXPOSE 8000
ENTRYPOINT ["backend-entrypoint"]

FROM app AS nextflow-worker

ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64 \
    NXF_OFFLINE=true

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl docker-cli git openjdk-21-jre-headless \
    && curl -fsSL \
        "https://github.com/nextflow-io/nextflow/releases/download/v25.04.8/nextflow-25.04.8-dist" \
        -o /usr/local/bin/nextflow \
    && echo "df18b2c5d89b47f471c71379a8f830a79973c1ba6ff56a55289483764d5e02ac  /usr/local/bin/nextflow" | sha256sum -c - \
    && chmod 0755 /usr/local/bin/nextflow \
    && docker --version \
    && java -version \
    && nextflow -version \
    && rm -rf /var/lib/apt/lists/*

FROM app AS backend
