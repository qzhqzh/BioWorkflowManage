# BioWorkflowManage：仓库根目录 docker-compose.yml 的环境变量模板
# 首次部署复制为同目录的 .env；已有部署只补充/修改所需项，不要覆盖已有 .env。
# .env 是隐藏文件，使用 ls -la .env 查看。修改此 .env.example 不会改变正在运行的服务。
# 先看 A 区；B 区通常保持默认。只使用 miniwdl 时，可跳过 Nextflow 专区。
# 以下以 # 开头的配置示例不会生效，使用时需取消注释并填写本机实际值。

# ============================================================================
# A. 部署时常用、需要确认的配置
# ============================================================================

# A1. 首次部署必填：数据库密码与应用密钥，分别生成，不要复用或提交到 Git。
# 可分别运行 openssl rand -hex 32 生成随机值。
# 已有数据库不要仅修改这里的密码；已有 DJANGO_SECRET_KEY 也不要在升级时重新生成。
POSTGRES_PASSWORD=
DJANGO_SECRET_KEY=

# A2. 网页 / API 访问与登录
APP_PORT=8082
# HTTPS 保持 1；仅在可信内网临时使用 HTTP 时，将下面两项都改为 0。
# HTTP 不加密登录凭据。HTTP + Secure=1 会导致 Cookie 不可用、登录后接口 401。
# 以后切换到 HTTPS 时恢复为 1；不要通过关闭 DJANGO_AUTH_REQUIRED 解决登录问题。
DJANGO_SESSION_COOKIE_SECURE=1
DJANGO_CSRF_COOKIE_SECURE=1
# 部署到新 IP / 域名时，取消相应注释并替换示例地址；保留 localhost,127.0.0.1 供健康检查使用。
# ALLOWED_HOSTS 只填 IP / 域名，不带协议和端口；CSRF / CORS 填完整来源（协议、主机、端口）。
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],192.168.1.100
# DJANGO_CSRF_TRUSTED_ORIGINS=http://192.168.1.100:8082
# CORS 仅在浏览器前端与 API 不同源时需要；后端服务用 Token 调用不依赖 CORS。
# CORS_ALLOWED_ORIGINS=https://portal.example.com
# 默认已有一层 gateway；前面再加可信反向代理时，按实际代理层数调整。
DJANGO_TRUSTED_PROXY_COUNT=1

# A3. 原始数据、参考数据库、结果与缓存目录
# HOST_PATH 是服务器上的实际目录；原始数据和参考库在容器内只读挂载。
# 下列相对路径与 /analysis/* 执行路径适用于默认的 miniwdl 隔离模式（wdl-runtime）。
# 使用 analysis-worker-host（wdl-host-runtime）时：
#   - 参考 .env.host.example 与 docs/12-miniwdl-execution.md，不要覆盖现有 .env；
#   - 下面四组 HOST_PATH / EXECUTION_ROOT 必须分别设置为相同的宿主机绝对路径；
#   - ANALYSIS_CACHE_HOST_PATH 也必须使用绝对路径；NAS 必须先确认已挂载。
# 例如 rawdata 两项都设置为 /mnt/nas/workspace/rawdata，而不是 /analysis/rawdata。
ANALYSIS_RAWDATA_HOST_PATH=./workspace/rawdata
ANALYSIS_RAWDATA_EXECUTION_ROOT=/analysis/rawdata
ANALYSIS_DATABASE_HOST_PATH=./workspace/databases
ANALYSIS_DATABASE_EXECUTION_ROOT=/analysis/databases
ANALYSIS_RUN_HOST_PATH=./data/analysis-runs
ANALYSIS_RUN_EXECUTION_ROOT=/analysis/runs
# 对象存储输入的本地暂存目录；隔离模式可保留默认，宿主模式仍需按上述规则改为绝对路径。
ANALYSIS_INPUT_STAGING_HOST_PATH=./data/input-staging
ANALYSIS_INPUT_STAGING_EXECUTION_ROOT=/analysis/input-staging
ANALYSIS_CACHE_HOST_PATH=./data/analysis-cache

# A4. miniwdl 执行条件（只启动网页 / API 不等于启动分析 worker）
# 选择 wdl-runtime 或 wdl-host-runtime，启动方式见 docs/12-miniwdl-execution.md。
# 宿主 Docker 模式必须把下面示例值替换为 stat -c '%g' /var/run/docker.sock 的输出。
# 988 不是所有服务器都通用的值；隔离模式不使用此权限。
MINIWDL_DOCKER_GID=988
# worker 默认 UID/GID 为 1000，需要能读取输入并写入结果、暂存、缓存目录。
# 如需适配本机文件属主，可在 .env 中显式配置（参考 id -u / id -g）：
# MINIWDL_UID=1000
# MINIWDL_GID=1000
# 可用内存低于此值（GiB）时任务等待；这是启动门槛，不是分配给任务的内存上限。
# 按流程峰值和宿主机预留内存评估，不要仅为启动任务而随意调低。
ANALYSIS_MIN_AVAILABLE_MEMORY_GB=40

# A5. 对接外部业务系统时按需配置；仅轮询状态并下载结果可先保留这些默认值。
# 调用方使用独立 Service Account Token，保存在调用方后端；不在此处填写业务系统密码。
# 接口与签名约定见 docs/14-integration-api-and-mcp.md。
# Webhook：启用时建议设置独立随机签名主密钥；更换已有密钥需协调回调接收方。
WEBHOOK_SIGNING_KEY=
# 回调目标使用 HTTP / 私网地址时，分别显式允许目标主机；多个值用逗号分隔。
# 这里填主机名或 IP，不带协议、端口、路径；不使用回调则留空。
WEBHOOK_ALLOWED_HTTP_HOSTS=
WEBHOOK_PRIVATE_HOST_ALLOWLIST=
# S3/MinIO 输入配置与凭据文件目录；不要放入原始数据目录或提交到 Git。
ANALYSIS_OBJECT_STORAGE_SECRETS_HOST_PATH=./secrets/object-storage
# 结果交付：受管目标目录，以及交付 profile / 凭据文件目录。
ANALYSIS_ARTIFACT_EXPORT_HOST_PATH=./data/artifact-exports
ANALYSIS_ARTIFACT_EXPORT_SECRETS_HOST_PATH=./secrets/artifact-export

# ============================================================================
# B. 高级配置：通常保持默认，仅在排障、容量评估或特定功能启用时调整
# 单位按变量后缀区分：SECONDS=秒，BYTES=字节，DAYS=天，PERCENT=百分比。
# ============================================================================

# B1. 数据库命名、测试账号初始化与登录限速
# 首次部署一般无需改库名/用户名；已有数据库不要只改环境变量来重命名。
POSTGRES_DB=bioworkflow
POSTGRES_USER=bioworkflow
# 默认不自动创建测试账号，不允许默认测试密码；正式环境保持关闭。
DJANGO_SEED_USERS=0
DJANGO_SEED_ALLOW_DEFAULT_PASSWORDS=0
DJANGO_LOGIN_THROTTLE_RATE=30/min
DJANGO_LOGIN_THROTTLE_RETENTION_DAYS=7

# B2. miniwdl 隔离网络与基础设施重试
# 下列子网仅在与已有 Docker / VPN / 局域网网段冲突时修改。
MINIWDL_CONTROL_SUBNET=10.253.0.0/24
MINIWDL_EGRESS_SUBNET=10.253.1.0/24
# 基础设施故障默认不自动重试，避免失联任务与新尝试重复占用资源。
ANALYSIS_INFRASTRUCTURE_RETRIES=0
ANALYSIS_INFRASTRUCTURE_RETRY_DELAY_SECONDS=15

# B3. Nextflow 专区：只使用 miniwdl 时无需调整，也无需启动 nextflow-runtime。
NEXTFLOW_MIN_AVAILABLE_MEMORY_GB=40
NEXTFLOW_REGISTRY_BOOTSTRAP_PORT=38084

# B4. Webhook 通知：超时、轮询、租约与重试退避
WEBHOOK_DELIVERY_TIMEOUT_SECONDS=10
WEBHOOK_DELIVERY_POLL_SECONDS=2
WEBHOOK_DELIVERY_LEASE_SECONDS=60
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_BACKOFF_BASE_SECONDS=5
WEBHOOK_BACKOFF_MAX_SECONDS=3600
WEBHOOK_RESPONSE_MAX_BYTES=2048

# B5. S3/MinIO 输入：对象预检、下载暂存、并发和磁盘预算
# 未使用对象存储输入时可整组保留默认；不要为了绕过校验而放宽这些限制。
ANALYSIS_OBJECT_HEAD_TIMEOUT_SECONDS=10
ANALYSIS_OBJECT_HEAD_REQUEST_TIMEOUT_SECONDS=20
ANALYSIS_OBJECT_HEAD_MAX_CONCURRENT=8
ANALYSIS_OBJECT_STAGE_TIMEOUT_SECONDS=3600
ANALYSIS_OBJECT_STAGE_RUN_TIMEOUT_SECONDS=7200
ANALYSIS_OBJECT_STAGE_SLOT_WAIT_SECONDS=600
ANALYSIS_OBJECT_STAGE_LEASE_SECONDS=7260
ANALYSIS_OBJECT_STAGE_MAX_CONCURRENT_RUNS=2
ANALYSIS_OBJECT_STAGE_MAX_ITEMS=64
ANALYSIS_OBJECT_STAGE_MAX_OBJECT_BYTES=1099511627776
ANALYSIS_OBJECT_STAGE_MAX_RUN_BYTES=2199023255552
ANALYSIS_OBJECT_STAGE_MAX_RESERVED_BYTES=4398046511104
ANALYSIS_OBJECT_STAGE_MIN_FREE_BYTES=10737418240
ANALYSIS_OBJECT_STAGE_CHUNK_BYTES=8388608

# B6. 对象暂存缓存回收：保留期、水位线与扫描预算，不代表自动删除业务原始数据。
ANALYSIS_OBJECT_STAGE_RETENTION_DAYS=30
ANALYSIS_OBJECT_STAGE_GC_HIGH_WATER_PERCENT=85
ANALYSIS_OBJECT_STAGE_GC_LOW_WATER_PERCENT=75
ANALYSIS_OBJECT_STAGE_GC_MAX_FILES=1000
ANALYSIS_OBJECT_STAGE_GC_SCAN_MAX_FILES=1000000

# B7. 结果交付与保留：超时、重试、分块和保留策略边界
ANALYSIS_ARTIFACT_EXPORT_TIMEOUT_SECONDS=3600
ANALYSIS_ARTIFACT_EXPORT_POLL_SECONDS=2
ANALYSIS_ARTIFACT_EXPORT_LEASE_SECONDS=3660
ANALYSIS_ARTIFACT_EXPORT_MAX_ATTEMPTS=5
ANALYSIS_ARTIFACT_EXPORT_BACKOFF_BASE_SECONDS=5
ANALYSIS_ARTIFACT_EXPORT_BACKOFF_MAX_SECONDS=3600
ANALYSIS_ARTIFACT_EXPORT_CHUNK_BYTES=8388608
ANALYSIS_ARTIFACT_EXPORT_MANIFEST_MAX_BYTES=1048576
ANALYSIS_ARTIFACT_RETENTION_MIN_DAYS=30
ANALYSIS_ARTIFACT_RETENTION_MAX_DAYS=3650
ANALYSIS_ARTIFACT_CLEANUP_LEASE_SECONDS=3600

# B8. 参考资源与输入校验：时间、扫描条目、深度、文本和文件大小限制
ANALYSIS_RESOURCE_MANIFEST_TIMEOUT_SECONDS=2
ANALYSIS_WORKER_RESOURCE_MANIFEST_TIMEOUT_SECONDS=300
ANALYSIS_RESOURCE_MANIFEST_MAX_ENTRIES=100000
ANALYSIS_RESOURCE_MANIFEST_MAX_DEPTH=128
ANALYSIS_MANAGED_RESOURCE_MAX_ITEMS=256
ANALYSIS_INPUT_TEXT_LINE_MAX_CHARS=1048576
ANALYSIS_INPUT_GZIP_HEADER_MAX_BYTES=65536
ANALYSIS_MANAGED_FILE_CHECKSUM_MAX_BYTES=17179869184

# B9. 输出固化与完整性校验：容量、扫描预算和 JSON 大小限制
ANALYSIS_OUTPUT_SNAPSHOT_MAX_ITEMS=256
ANALYSIS_OUTPUT_SNAPSHOT_MAX_BYTES=1099511627776
ANALYSIS_OUTPUT_SNAPSHOT_MAX_DIRECTORY_ENTRIES=200000
ANALYSIS_OUTPUT_SNAPSHOT_TIMEOUT_SECONDS=300
ANALYSIS_OUTPUT_SNAPSHOT_MIN_FREE_BYTES=1073741824
ANALYSIS_OUTPUT_MANIFEST_MAX_DEPTH=32
ANALYSIS_OUTPUT_VALUE_MAX_BYTES=65536
ANALYSIS_RESULT_JSON_MAX_BYTES=67108864
