ARG BUN_BASE_IMAGE=m.daocloud.io/docker.io/oven/bun:1.3.14@sha256:e10577f0db68676a7024391c6e5cb4b879ebd17188ab750cf10024a6d700e5c4
ARG NODE_BASE_IMAGE=m.daocloud.io/docker.io/library/node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32
ARG ANALYSIS_NODE_VERSION=dev
ARG GIT_REVISION=unknown

FROM ${BUN_BASE_IMAGE} AS build
WORKDIR /app
COPY frontend/package.json frontend/bun.lock ./
RUN bun install --frozen-lockfile --registry https://registry.npmmirror.com
COPY frontend ./
RUN bun run build

FROM ${NODE_BASE_IMAGE}
ARG ANALYSIS_NODE_VERSION
ARG GIT_REVISION
LABEL org.opencontainers.image.title="BioWorkflowManage Analysis Node console" \
    org.opencontainers.image.version="${ANALYSIS_NODE_VERSION}" \
    org.opencontainers.image.revision="${GIT_REVISION}" \
    org.opencontainers.image.source="https://github.com/qzhqzh/BioWorkflowManage"
WORKDIR /app
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=3000
COPY --from=build /app/.output ./.output
EXPOSE 3000
USER node
CMD ["node", ".output/server/index.mjs"]
